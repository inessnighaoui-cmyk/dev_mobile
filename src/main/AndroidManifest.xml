<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ines.nouveau4">

    <application
        android:allowBackup="true"
        android:label="Suivi de notes"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuiviNotes">

        <!-- Écran de démarrage -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".NotesActivity" android:exported="false" />
        <activity android:name=".ResultActivity" android:exported="false" />
        <activity android:name=".PrecedentActivity" android:exported="false" />
        <activity android:name=".EvolutionActivity" android:exported="false" />
    </application>
</manifest>